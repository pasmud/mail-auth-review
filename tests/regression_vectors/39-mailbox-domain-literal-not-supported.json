    " dkim=pass header.d=signer.example\n"
  ],
  "servers": [],
  "expected": {
    "server_filter": [], "total_fields": 1, "excluded_fields": 0,
    "fields": [{
      "line": 1, "authserv_id": "mx.example", "version": "1", "status": "partial",
      "claims": [{
        "method": "dkim", "result": "pass", "method_version": "1", "reason": null,
        "properties": [{"name": "header.d", "value": "signer.example"}]
